# Dependências do Node (ESSENCIAL - nunca vai pro GitHub)
/node_modules/

# Arquivos de Build e Distribuição gerados pelo Angular
/dist/
/tmp/
/out-tsc/

# Arquivos de Log e Cache do npm/Angular
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
.angular/cache/

# Arquivos específicos do Sistema Operacional
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Arquivos de Editor / IDE (como VS Code)
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
